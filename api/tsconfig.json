{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "strict": true,
    "types": ["node"],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "noEmit": true,
    "noImplicitAny": true,
    "strictNullChecks": true,
    "target": "esnext",
    "lib": ["es2023"],
    "paths": {
      "utils": ["../packages/utils/src/index.ts"]
    }
  },
  "include": ["./**/*.ts", "./**/*.tsx", "./**/*.d.ts"],
  "exclude": ["node_modules", "dist", "apps", "packages"]
}
